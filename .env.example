# Literature pipeline credentials. Copy to `.env` and fill in.
# .env is gitignored; .env.example is committed so the required vars are visible.

# Polite-pool email for OpenAlex (gets you priority + faster rate limits, free).
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=

# Free key from https://core.ac.uk/services/api (registered email + 1 button).
# Without it the CORE adapter is skipped.
CORE_API_KEY=

# Recommended: Semantic Scholar API key. The unkeyed pool is heavily throttled
# and often returns 429 immediately — without a key the SS adapter usually
# returns 0 results. Apply (free): https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# Elsevier (Scopus + ScienceDirect). Apply at https://dev.elsevier.com (~15 min,
# institutional email). When this is unset, the Scopus/ScienceDirect adapters
# return an empty result and log a "no key" notice.
ELSEVIER_API_KEY=
